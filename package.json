{
  "name": "@flancer32/alarisa-mob",
  "version": "0.3.0",
  "description": "Mobile browser and PWA composition package for Alarisa.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/flancer32/alarisa-mob.git"
  },
  "homepage": "https://github.com/flancer32/alarisa-mob",
  "bugs": {
    "url": "https://github.com/flancer32/alarisa-mob/issues"
  },
  "keywords": [
    "alarisa",
    "mobile",
    "pwa",
    "frontend",
    "teqfw"
  ],
  "types": "types.d.ts",
  "files": [
    "ai/",
    "jsconfig.json",
    "src/",
    "web/",
    "types.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "namespaces": [
      {
        "prefix": "Alarisa_Mob_",
        "path": "./src",
        "ext": ".mjs"
      }
    ]
  },
  "scripts": {
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 -r node --test",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@flancer32/teq-web": ">=0.13.1",
    "@teqfw/log": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
